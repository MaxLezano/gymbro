{
  "expo": {
    "name": "GymBro",
    "slug": "gymbro",
    "scheme": "gymbro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gymbro.fitnessapp",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-router",
      [
        "./plugins/withBrandAccent.js",
        {
          "accent": "#FF9F0A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF9F0A"
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Tu entrenador de gimnasio: rutinas según tu objetivo y equipo, registro de series, progreso y un coach con IA."
  }
}
