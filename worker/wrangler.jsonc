{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymbro-coach",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  }
  // Secrets: GEMINI_API_KEY (`npx wrangler secret put GEMINI_API_KEY`) and APP_KEY,
  // the same value as EXPO_PUBLIC_COACH_KEY in the app's .env.local.
}
