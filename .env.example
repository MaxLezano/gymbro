# Copy to .env.local (git-ignored) and fill in. Restart Metro after changing.

# Google Sign-In: OAuth "Web application" client id from Google Cloud.
# Also create an "Android" client for com.gymbro.fitnessapp with the signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Supabase cloud backup (Project Settings > API). The publishable/anon key is
# safe to ship: row level security limits every user to their own rows.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
